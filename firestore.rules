rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: users
    // Fields: uid, name, email, role (primary_admin, secondary_admin, user), studentIds, permissions
    //
    // Collection: students
    // Fields: name, email, grade, status, enrollmentId, engagementScore, responsibleName, responsibleAvatar, photoUrl, createdAt
    //
    // Collection: claims
    // Fields: userId, studentId, subject, description, status, createdAt
    //
    // Collection: proofs
    // Fields: userId, studentId, paymentId, proofUrl, status, notes, createdAt
    //
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isPrimaryAdminEmail() {
      return request.auth.token.email == "valter1990vado@gmail.com" || 
             request.auth.token.email == "admin@eloescolar.com";
    }

    function isPrimaryAdmin() {
      return isAuthenticated() && 
        (getUserData().role == 'primary_admin' || isPrimaryAdminEmail());
    }

    function isSecondaryAdmin() {
      return isAuthenticated() && getUserData().role == 'secondary_admin';
    }

    function isAnyAdmin() {
      return isPrimaryAdmin() || isSecondaryAdmin();
    }

    function isUser() {
      return isAuthenticated() && getUserData().role == 'user';
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Validation Helpers
    function isValidUser(data) {
      return data.uid is string && data.email is string && data.role in ['primary_admin', 'secondary_admin', 'user'];
    }

    function isValidGrade(data) {
      return data.studentId is string && data.subject is string && data.value is number && data.value >= 0 && data.value <= 20;
    }

    function isValidClaim(data) {
      return data.userId == request.auth.uid && data.subject is string && data.description is string;
    }

    function isValidProof(data) {
      return data.userId == request.auth.uid && data.proofUrl is string;
    }

    // Rules
    
    // User Profiles
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isPrimaryAdmin());
      allow create: if isAuthenticated() && isOwner(userId) && isValidUser(request.resource.data) && (
        request.resource.data.role == 'user' || 
        (isPrimaryAdminEmail() && request.resource.data.role == 'primary_admin')
      );
      allow update: if isAuthenticated() && (
        (isOwner(userId) && request.resource.data.role == resource.data.role) || 
        isPrimaryAdmin()
      );
    }

    // Students
    match /students/{studentId} {
      allow read: if isAnyAdmin() || (isUser() && studentId in getUserData().studentIds);
      allow write: if isAnyAdmin();
    }

    // Classes
    match /classes/{classId} {
      allow read: if isAuthenticated();
      allow write: if isAnyAdmin();
    }

    // Grades
    match /grades/{gradeId} {
      allow read: if isAnyAdmin() || (isUser() && resource.data.studentId in getUserData().studentIds);
      allow write: if isAnyAdmin() && isValidGrade(request.resource.data);
    }

    // Attendance
    match /attendance/{attendanceId} {
      allow read: if isAnyAdmin() || (isUser() && resource.data.studentId in getUserData().studentIds);
      allow write: if isAnyAdmin();
    }

    // Payments
    match /payments/{paymentId} {
      allow read: if isAnyAdmin() || (isUser() && resource.data.studentId in getUserData().studentIds);
      allow write: if isPrimaryAdmin();
    }

    // Leads (Funnel)
    match /leads/{leadId} {
      allow read, write: if isAnyAdmin();
    }

    // Events (Calendar)
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow write: if isAnyAdmin();
    }

    // Claims
    match /claims/{claimId} {
      allow read: if isAnyAdmin() || (isUser() && resource.data.userId == request.auth.uid);
      allow create: if isUser() && isValidClaim(request.resource.data);
      allow update: if isAnyAdmin();
    }

    // Payment Proofs
    match /proofs/{proofId} {
      allow read: if isAnyAdmin() || (isUser() && resource.data.userId == request.auth.uid);
      allow create: if isUser() && isValidProof(request.resource.data);
      allow update: if isAnyAdmin();
    }
  }
}
